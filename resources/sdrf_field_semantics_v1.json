  "fields": {
    "characteristics[single cell isolation protocol]": {
      "semantic_definition": "Method used to isolate or collect an individual cell, oocyte, or cell-equivalent sample for single-cell proteomics. The value must describe the physical or instrumental isolation/collection method, not downstream lysis, digestion, labeling, chromatography, or mass-spectrometry fragmentation.",
